{
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/film/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ig",
      "destination": "/start/?utm_source=instagram&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/ig/",
      "destination": "/start/?utm_source=instagram&utm_medium=bio",
      "permanent": false
    }
  ]
}
